# ============================================================
# SECRETS — Tambahkan di panel "Secrets" (bukan Configurations)
# Nilai sensitif, jangan pernah commit ke git
# ============================================================

# Database Supabase (utama)
SUPABASE_PG_URL=postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres

# Supabase keys (dari Project Settings > API)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_DATABASE_URL=postgresql://...

# WhatsApp via CST WA Gateway
CST_WA_GATEWAY_URL=https://wa.cstlogistic.co.id
CST_WA_GATEWAY_API_KEY=xxx
# Opsional: gunakan device tertentu; kosongkan untuk default device gateway
CST_WA_DEVICE_ID=
ADMIN_WHATSAPP=6281234567890
# Opsional: Group JID untuk notifikasi admin
ADMIN_WA_GROUP=120363xxxxxxxxxxx@g.us

# Session
SESSION_SECRET=random-string-panjang-minimal-32-karakter

# Google OAuth
# Production callback wajib didaftarkan di Google Cloud:
# https://tenant.travelintrips.co.id/api/auth/google/callback
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
GOOGLE_CALLBACK_URL=https://tenant.travelintrips.co.id/api/auth/google/callback
GOOGLE_OWNER_EMAILS=admcst001@gmail.com

# Google Service Account JSON (jika dipakai)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Portal admin key
PORTAL_ADMIN_KEY=random-hex-string

# OpenAI (jika dipakai)
OPENAI_API_KEY=sk-...

# ============================================================
# CONFIGURATIONS — Tambahkan di panel "Configurations"
# Nilai non-sensitif, aman berbeda antara dev & production
# ============================================================

APP_URL=https://xxx.replit.app
LOG_LEVEL=info
NODE_ENV=development
ENABLE_DEV_LOGIN=true
