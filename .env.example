# ═══════════════════════════════════════════════════════════════════════════
# MALL ADMIN PORTAL — Environment Variables
# Salin file ini ke .env (jangan commit .env ke git)
# ═══════════════════════════════════════════════════════════════════════════

# ─── Environment ──────────────────────────────────────────────────────────
# "development" atau "production"
NODE_ENV=development

# ─── Database — DEVELOPMENT ───────────────────────────────────────────────
# Supabase connection pooler (port 6543) untuk development
# Format: postgresql://postgres.PROJECT_ID:PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres
SUPABASE_PG_URL=postgresql://postgres.xxx:password@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres

# Fallback: Replit managed PostgreSQL (diset otomatis oleh platform)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Database — PRODUCTION ────────────────────────────────────────────────
# WAJIB diset di production. Gunakan Supabase project BERBEDA dari development.
# Server akan menolak start jika ini tidak diset saat NODE_ENV=production.
SUPABASE_PG_URL_PROD=postgresql://postgres.PROD_PROJECT_ID:PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres

# ─── Server ───────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info

# ─── Session ──────────────────────────────────────────────────────────────
# WAJIB di production — ganti dengan string acak panjang (min. 64 karakter)
# Generate: openssl rand -base64 64
SESSION_SECRET=ganti-dengan-string-rahasia-panjang-minimal-64-karakter

# ─── CORS (production only) ───────────────────────────────────────────────
# Comma-separated origin yang diizinkan. Kosongkan jika frontend dan API
# berada di domain yang sama (reverse proxy — kasus Replit deployment).
ALLOWED_ORIGINS=

# ─── WhatsApp (Fonnte) ────────────────────────────────────────────────────
# Daftarkan di https://fonnte.com
FONNTE_TOKEN=
FONNTE_API_KEY=
FONNTE_SENDER=
FONNTE_ADMIN_WA=
FONNTE_WEBHOOK_SECRET=

# ─── Google OAuth (opsional) ──────────────────────────────────────────────
# Buat credentials di: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://DOMAIN_ANDA/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── Supabase Storage/Realtime (opsional) ─────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Dev Login (development only) ─────────────────────────────────────────
# Di development (NODE_ENV != production) dev-login selalu aktif.
# Di production set ke "true" HANYA untuk testing sementara.
ENABLE_DEV_LOGIN=

# ─── Admin Portal (frontend) ──────────────────────────────────────────────
# PORT=5000
# BASE_PATH=/
