# ============================================================
# SECRETS — Tambahkan di panel "Secrets" (bukan Configurations)
# Nilai sensitif, jangan pernah commit ke git
# ============================================================

# Database Supabase (utama)
SUPABASE_PG_URL=postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres

# Supabase keys (dari Project Settings > API)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_DATABASE_URL=postgresql://...

# WhatsApp via Fonnte (dari fonnte.com)
FONNTE_TOKEN=xxx
FONNTE_ADMIN_WA=6281234567890

# Session
SESSION_SECRET=random-string-panjang-minimal-32-karakter

# Google OAuth (jika dipakai)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# Google Service Account JSON (jika dipakai)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Portal admin key
PORTAL_ADMIN_KEY=random-hex-string

# OpenAI (jika dipakai)
OPENAI_API_KEY=sk-...

# ============================================================
# CONFIGURATIONS — Tambahkan di panel "Configurations"
# Nilai non-sensitif, aman berbeda antara dev & production
# ============================================================

APP_URL=https://xxx.replit.app
LOG_LEVEL=info
NODE_ENV=development
ENABLE_DEV_LOGIN=true
