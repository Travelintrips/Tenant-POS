# ─── Database ────────────────────────────────────────────────────
# Replit PostgreSQL — set otomatis oleh platform, tidak perlu diubah
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Server ──────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# ─── Session ─────────────────────────────────────────────────────
# Wajib di production. Ganti dengan string acak panjang (min. 32 karakter)
SESSION_SECRET=ganti-dengan-string-rahasia-panjang

# ─── Google OAuth (opsional) ─────────────────────────────────────
# Buat credentials di: https://console.cloud.google.com/apis/credentials
# Pastikan redirect URI sudah ditambahkan: https://DOMAIN_ANDA/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Supabase Realtime (opsional) ────────────────────────────────
# Hanya diperlukan jika ingin fitur real-time sync via Supabase
# Jika tidak diset, aplikasi tetap berjalan normal (polling biasa)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ─── Admin Portal (frontend) ─────────────────────────────────────
PORT=5000
BASE_PATH=/
